# =============================================================================
# Frontend Environment Variables (exposed to browser via Vite - NO SECRETS HERE)
# =============================================================================

# Optional endpoint for live Google Reviews proxy (e.g., /api/reviews on Vercel/Netlify)
# Leave empty to use built-in curated fallback reviews without network calls.
VITE_REVIEWS_API_URL=

# Optional TrekkSoft Merchant / Booking Gateway configuration
VITE_TREKKSOFT_MERCHANT_URL=
VITE_WHATSAPP_NUMBER=38269000000

# =============================================================================
# Server-Side / Serverless Function Variables (KEEP SECRET - NEVER PREFIX VITE_)
# =============================================================================

# Google Places API (New) key used by /api/reviews serverless proxy
GOOGLE_PLACES_API_KEY=

# Google Place ID for Budva Diving Center
GOOGLE_PLACE_ID=
